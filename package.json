{
  "name": "pvng",
  "version": "2.0.0-dev",
  "description": "WebGL2 protein viewer",
  "type": "module",
  "homepage": "https://github.com/awaterho/pvng",
  "author": {
    "name": "Andrew Waterhouse"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/awaterho/pvng.git"
  },
  "bugs": {
    "url": "https://github.com/awaterho/pvng/issues"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/pv.d.ts",
      "import": "./dist/pv.js",
      "require": "./dist/pv.cjs"
    }
  },
  "main": "./dist/pv.cjs",
  "module": "./dist/pv.js",
  "types": "./dist/pv.d.ts",
  "unpkg": "./dist/pv.iife.js",
  "files": [
    "README.md",
    "LICENSE.txt",
    "dist",
    "pdbs"
  ],
  "keywords": [
    "protein",
    "3d",
    "webgl",
    "biojs"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:debug": "vite build --mode debug",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "gl-matrix": "^3.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@playwright/test": "^1.47.2",
    "eslint": "^9.11.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.7.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.1"
  }
}
